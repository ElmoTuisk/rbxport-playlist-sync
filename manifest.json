{
  "id": "playlist-sync",
  "name": "Playlist Sync",
  "version": "0.11.4",
  "bridgeVersion": 1,
  "runtime": "Node.js 24",
  "entry": "src/server.mjs",
  "hostPatchRequired": false,
  "integration": "Windows rbxport 1.9.0 opt-in local automation (RBXPORT_DEVTOOLS_PORT)",
  "capabilities": [
    "library.read",
    "tracks.import",
    "playlists.add",
    "playlists.reorder",
    "tracks.analyse"
  ],
  "qualityPolicy": "Default: MP3 >= 320 kbps or lossless; optional AAC >= 256 kbps preserved as M4A",
  "display": "in-rbxport-popover-below-tag-list",
  "installer": "playlist-sync-0.11.4-windows-setup.exe"
}
